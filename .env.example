# Copy this file to .env and fill in real values. Never commit .env itself.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Optional: only needed if you have a paid exchangerate-api.com key
EXCHANGE_RATE_API_KEY=

# Optional: overrides the default SQLite path, e.g. for Postgres in production
# DATABASE_URL=postgresql://user:password@localhost:5432/smartcalculator
